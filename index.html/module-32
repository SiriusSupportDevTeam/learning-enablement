<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Service Excellence Playbook · Fi Barking Labs</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&display=swap">
<style>
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
--bg:#fff;--card:#fff;--ink:#111;--muted:#555;--line:#e3e3e3;--accent:#FFC800;--accent-ink:#111;--ok:#17703a;--soft:#fff4c2;--gold:#FFC800;--link:#111}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0b0b0b;--card:#161616;--ink:#fff;--muted:#bdbdbd;--line:#333;--accent:#FFC800;--accent-ink:#111;--ok:#5fd68a;--soft:#2a2410;--gold:#FFC800;--link:#FFC800}}
:root[data-theme="dark"]{--bg:#0b0b0b;--card:#161616;--ink:#fff;--muted:#bdbdbd;--line:#333;--accent:#FFC800;--accent-ink:#111;--ok:#5fd68a;--soft:#2a2410;--gold:#FFC800;--link:#FFC800}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*,*::before,*::after{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.55 "Segoe UI",system-ui,-apple-system,Roboto,Helvetica,Arial,sans-serif}
.wrap{max-width:980px;margin:0 auto;padding:24px 18px 48px}
header{margin-bottom:22px}
.tag{display:inline-block;font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--accent);background:var(--soft);padding:4px 10px;border-radius:999px}
h1{font-size:clamp(26px,5vw,38px);line-height:1.15;margin:12px 0 8px}
header p{color:var(--muted);margin:0;max-width:70ch}
.meta{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}
.meta span{font-size:13px;border:1px solid var(--line);background:var(--card);padding:4px 10px;border-radius:8px;color:var(--muted)}
.grid{display:grid;grid-template-columns:1fr;gap:18px}
@media(min-width:860px){.grid{grid-template-columns:1.9fr 1fr;align-items:start}}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px}
.card h2{font-size:18px;margin:0 0 10px}
video{width:100%;aspect-ratio:16/9;background:#000;border-radius:10px;display:block}
.bar{height:8px;background:var(--line);border-radius:99px;overflow:hidden;margin:12px 0 4px}
.bar i{display:block;height:100%;width:0;background:var(--accent);transition:width .3s}
.small{font-size:13px;color:var(--muted)}
.speeds{display:flex;gap:6px;margin-top:10px;flex-wrap:wrap}
button,.btn{font:inherit;cursor:pointer;border:1px solid var(--line);background:var(--card);color:var(--ink);padding:7px 12px;border-radius:9px;text-decoration:none;display:inline-block}
button[aria-pressed="true"]{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}
.btn.primary{background:var(--accent);color:var(--accent-ink);border-color:var(--accent);font-weight:600;padding:11px 16px;width:100%;text-align:center}
.btn:focus-visible,button:focus-visible,video:focus-visible{outline:3px solid var(--ink);outline-offset:2px}
.steps{list-style:none;margin:0;padding:0;display:grid;gap:10px}
.steps li{display:flex;gap:10px;align-items:flex-start;padding:10px;border:1px solid var(--line);border-radius:10px}
.steps input{width:20px;height:20px;margin-top:2px;accent-color:var(--accent)}
.steps label{flex:1;cursor:pointer}
.steps li.done{border-color:var(--ok)}
.steps li.done label span{text-decoration:line-through;color:var(--muted)}
.status{margin-top:14px;padding:12px;border-radius:10px;background:var(--soft);font-weight:600}
.status.ok{color:var(--ok)}
.links{margin-top:14px;display:grid;gap:8px}
.links a{color:var(--link);font-weight:600;text-decoration:underline;text-decoration-color:#FFC800;text-decoration-thickness:2px;text-underline-offset:3px}
.stack{display:grid;gap:18px}
footer{margin-top:24px;color:var(--muted);font-size:13px}
h1,h2,.tag{font-family:"Fredoka","Trebuchet MS","Segoe UI",system-ui,sans-serif}
.hero{position:relative;overflow:hidden;background:#111;color:#fff;padding:26px 22px;border-radius:18px;border-bottom:6px solid var(--gold)}
.hero>*:not(.paws){position:relative}
.hero h1{color:#fff}
.hero p{color:#e6e6e6}
.hero .tag{background:#FFC800;color:#111;font-weight:700}
.hero .meta span{background:transparent;border-color:#FFC800;color:#FFC800}
.hero .paws{position:absolute;right:-14px;top:-14px;width:230px;opacity:.22;pointer-events:none;transform:rotate(18deg)}
.card{border-top:4px solid var(--accent)}
.card h2{font-size:20px}
.bar i{background:#FFC800}
.steps li.done{background:var(--soft)}
.status{border-left:5px solid var(--gold)}
</style>
</head>
<body>
<div class="wrap">
<header class="hero">
  <svg class="paws" viewBox="0 0 100 100" aria-hidden="true" fill="#FFC800"><ellipse cx="50" cy="66" rx="22" ry="18"/><ellipse cx="22" cy="42" rx="9" ry="12" transform="rotate(-20 22 42)"/><ellipse cx="40" cy="26" rx="9" ry="13"/><ellipse cx="60" cy="26" rx="9" ry="13"/><ellipse cx="78" cy="42" rx="9" ry="12" transform="rotate(20 78 42)"/></svg>
  <span class="tag">🐾 Fi Barking Labs · Fi Repository</span>
  <h1>Service Excellence Playbook</h1>
  <p>A learning resource to help you strengthen your customer service skills, follow quality standards, and deliver consistent, empathetic, and effective support. It is your guide to best practices in customer interactions, communication, and resolution.</p>
  <div class="meta"><span>Video ≈ 26 min</span><span>Followed by the Service Excellence Assessment</span><span>Refresher for the new AI/auto-QA tool</span></div>
</header>

<div class="grid">
  <div class="stack">
    <section class="card" aria-labelledby="vh">
      <h2 id="vh">🎬 1 · Watch the training video</h2>
      <video id="v" controls preload="metadata" playsinline src="data:video/mp4;base64,">Your browser does not support embedded video.</video>
      <div class="bar" aria-hidden="true"><i id="pb"></i></div>
      <div class="small" id="pt">0% watched</div>
      <div class="speeds" role="group" aria-label="Playback speed">
        <button data-s="1" aria-pressed="true">1×</button><button data-s="1.25" aria-pressed="false">1.25×</button><button data-s="1.5" aria-pressed="false">1.5×</button>
      </div>
      <p class="small" style="margin-bottom:0">🐕 Trainer’s tip: the embedded video is a lightweight version. For the full-quality, autoplay version use the links on the right.</p>
    </section>
  </div>

  <aside class="stack">
    <section class="card" aria-labelledby="ah">
      <h2 id="ah">🦴 2 · Take the assessment</h2>
      <p class="small" style="margin-top:0">Complete the Service Excellence Assessment after watching the video. It opens in a new tab.</p>
      <a class="btn primary" id="assess" href="https://docs.google.com/forms/d/1YsES7q8C0tb_lsyyQ6G8sfLjx9P0AJHrJxGeZyMNh48/viewform?pli=1&amp;pli=1&amp;edit_requested=true" target="_blank" rel="noopener">Open the Service Excellence Assessment ↗</a>
      <div class="links small">
        <a href="https://drive.google.com/file/d/1UUfpYT1Op7eEJJujkZSxdQMhAzzjeLTE/view?usp=sharing" target="_blank" rel="noopener">Full-quality video (autoplay, Google Drive) ↗</a>
        <a href="https://canva.link/25vu0tp6ez0r8r9" target="_blank" rel="noopener">Alternative video (Canva) ↗</a>
      </div>
    </section>

    <section class="card" aria-labelledby="ph">
      <h2 id="ph">🧪 Your Lab report</h2>
      <ul class="steps" id="steps">
        <li data-k="watched"><input type="checkbox" id="c1"><label for="c1"><span>Watched the Playbook video</span></label></li>
        <li data-k="assessed"><input type="checkbox" id="c2"><label for="c2"><span>Opened and submitted the assessment</span></label></li>
      </ul>
      <div class="status" id="st">0 of 2 steps complete</div>
      <button id="reset" style="margin-top:10px">Reset progress</button>
    </section>
  </aside>
</div>
<footer>Progress is saved in this browser only and is a personal checklist; it does not replace LMS completion tracking.</footer>
</div>
<script>
(function(){
var KEY="sep-progress",state={watched:false,assessed:false};
try{var s=localStorage.getItem(KEY);if(s)state=Object.assign(state,JSON.parse(s))}catch(e){}
function save(){try{localStorage.setItem(KEY,JSON.stringify(state))}catch(e){}}
var items=document.querySelectorAll("#steps li");
function render(){var n=0;items.forEach(function(li){var k=li.dataset.k,on=!!state[k];li.classList.toggle("done",on);li.querySelector("input").checked=on;if(on)n++});
var st=document.getElementById("st");st.textContent=n===2?"Pawsome work! You’ve completed the Playbook. 🐾":n+" of 2 steps complete";st.classList.toggle("ok",n===2)}
items.forEach(function(li){li.querySelector("input").addEventListener("change",function(e){state[li.dataset.k]=e.target.checked;save();render()})});
var v=document.getElementById("v"),pb=document.getElementById("pb"),pt=document.getElementById("pt"),max=0;
v.addEventListener("timeupdate",function(){if(!v.duration)return;var p=Math.round(v.currentTime/v.duration*100);if(p>max)max=p;pb.style.width=max+"%";pt.textContent=max+"% watched";if(max>=95&&!state.watched){state.watched=true;save();render()}});
v.addEventListener("ended",function(){state.watched=true;save();render()});
document.querySelectorAll(".speeds button").forEach(function(b){b.addEventListener("click",function(){v.playbackRate=parseFloat(b.dataset.s);document.querySelectorAll(".speeds button").forEach(function(x){x.setAttribute("aria-pressed",x===b)})})});
document.getElementById("assess").addEventListener("click",function(){setTimeout(function(){if(confirm("Mark the assessment as submitted once you finish it. Mark it now?")){state.assessed=true;save();render()}},1500)});
document.getElementById("reset").addEventListener("click",function(){state={watched:false,assessed:false};max=0;pb.style.width="0";pt.textContent="0% watched";save();render()});
render();
})();
</script>
</body>
</html>
